}

### Eliminar un producto (soft delete)
### Esperado: 200
DELETE {{baseUrl}}/products/20
Authorization: Bearer {{token}}
Accept: application/json

### Obtener productos eliminados (papelera)
### Esperado: 200
GET {{baseUrl}}/products/trashed
Authorization: Bearer {{token}}
Accept: application/json

### Restaurar un producto eliminado
### Esperado: 200
POST {{baseUrl}}/products/20/restore
Authorization: Bearer {{token}}
Accept: application/json

### Eliminar permanentemente (solo Admin)
### Esperado: 200
DELETE {{baseUrl}}/products/20/force-delete
Authorization: Bearer {{token}}
Accept: application/json

### Crear codigo de proveedor — Proveedor 1 le pone "2781" al Arroz
### Esperado: 201
POST {{baseUrl}}/product-supplier-codes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "product_id": 6,
  "supplier_id": 1,
  "code": "2781"
}

### Proveedor 7 le pone "9034" al MISMO Arroz
### Esperado: 201
POST {{baseUrl}}/product-supplier-codes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "product_id": 6,
  "supplier_id": 7,
  "code": "9034"
}

### Match — ticket del proveedor 1, busca por codigo "2781"
### Esperado: 200, matched con matched_by: "codigo"
POST {{baseUrl}}/products/match
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "supplier_id": 1,
  "products": [
    { "nombre": "ARROZ", "codigo": "2781", "cantidad": 10, "precio_unitario": 12.5 }
  ]
}

### Match — ticket del proveedor 7, SU codigo distinto "9034"
### Esperado: 200, matched con matched_by: "codigo"
POST {{baseUrl}}/products/match
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "supplier_id": 7,
  "products": [
    { "nombre": "ARROZ", "codigo": "9034", "cantidad": 10, "precio_unitario": 12.5 }
  ]
}

### Match — buscar por nombre (sin supplier_id en el body)
### Esperado: 200, matched con matched_by: "nombre"
POST {{baseUrl}}/products/match
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "products": [
    { "nombre": "Coca Cola 600ml", "cantidad": 5, "precio_unitario": 18.50 }
  ]
}

### Match — producto inexistente
### Esperado: 200, unmatched incluye el nombre
POST {{baseUrl}}/products/match
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "products": [
    { "nombre": "Producto Inventado XYZ", "cantidad": 5, "precio_unitario": 30.00 }
  ]
}


